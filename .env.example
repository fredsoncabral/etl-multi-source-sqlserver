# Copie para .env e preencha com as credenciais do SEU ambiente.
# Nunca faça commit do arquivo .env (já está no .gitignore).

# --- Oracle (origem) ---
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=host:1521/ORCLPDB1
# Só preencher se o Oracle Database for anterior a 12.1 (erro DPY-3010 no modo thin):
ORACLE_CLIENT_LIB_DIR=

# --- SAP HANA (origem) ---
HANA_USER=
HANA_PASSWORD=
HANA_ADDRESS=
HANA_PORT=30015

# --- SQL Server (DESTINO) ---
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_SERVER=
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes

# --- SQL Server (origem, só quando --source sqlserver) ---
# Se omitidas, cai para as variáveis SQLSERVER_* de destino acima.
SQLSERVER_SOURCE_SERVER=
SQLSERVER_SOURCE_DATABASE=
SQLSERVER_SOURCE_USER=
SQLSERVER_SOURCE_PASSWORD=

# --- Ajustes de performance/resiliência (opcionais, têm default no código) ---
ETL_BATCH_SIZE=100000
ETL_MAX_RETRIES=5
ETL_RETRY_BASE_DELAY=5
